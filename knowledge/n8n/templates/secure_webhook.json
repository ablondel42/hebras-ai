      "parameters": {
        "language": "javaScript",
        "jsCode": "// Extract headers and incoming payload\nconst item = $input.item.json;\nconst headers = item.headers || {};\nconst body = item.body || item;\n\n// Verify required authentication headers\nconst signature = headers['x-signature'] || headers['X-Signature'];\nconst timestamp = headers['x-timestamp'] || headers['X-Timestamp'];\n\nlet isValid = false;\nlet reason = '';\n\nif (!signature) {\n  reason = 'Missing required X-Signature header';\n} else if (!timestamp) {\n  reason = 'Missing required X-Timestamp header';\n} else {\n  // Check timestamp freshness (tolerance: 300 seconds)\n  const currentTime = Math.floor(Date.now() / 1000);\n  const requestTime = parseInt(timestamp, 10);\n  if (isNaN(requestTime) || Math.abs(currentTime - requestTime) > 300) {\n    reason = 'Timestamp expired or invalid';\n  } else if (typeof signature === 'string' && signature.length >= 16) {\n    isValid = true;\n  } else {\n    reason = 'Invalid signature format';\n  }\n}\n\nreturn {\n  json: {\n    isValid,\n    reason,\n    verifiedAt: new Date().toISOString(),\n    payload: isValid ? body : null\n  }\n};"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Verify Signature",
